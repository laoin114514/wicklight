{
  "name": "wicklight",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "灯芯 WICKLIGHT — 灯火即视野与火力的暗夜生存动作肉鸽 (TypeScript + Canvas2D + WebAudio)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "playtest": "npm run build && node tools/playtest.mjs",
    "bench": "npm run build && node tools/bench-waves.mjs",
    "bench:weapons": "npm run build && node tools/bench-weapons.mjs",
    "bench:lamp": "npm run build && node tools/bench-lamp.mjs",
    "bench:wall": "npm run build && node tools/bench-wall.mjs",
    "perf": "npm run build && node tools/perf.mjs",
    "mobileperf": "npm run build && node tools/mobileperf.mjs",
    "viewportcheck": "npm run build && node tools/viewportcheck.mjs"
  },
  "keywords": [
    "game",
    "canvas",
    "roguelite",
    "survivors",
    "webaudio",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^7.1.0"
  }
}
